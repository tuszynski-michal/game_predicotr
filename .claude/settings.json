{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -I \"${CLAUDE_PROJECT_DIR}/scripts/hooks/block_large_read.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -I \"${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_paths.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -I \"${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_commands.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -I \"${CLAUDE_PROJECT_DIR}/scripts/hooks/format_edited_file.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

{
  "schemaVersion": 1,
  "selectorVersion": "fast-image-selector-v2",
  "notes": "Synthetic observations exercise grouping policy independently of OCR model quality. Real Pillow/OpenCV adapters have separate tests.",
  "cases": [
    {
      "id": "arbitrary-range-jump",
      "observations": [
        {"fingerprint": "a", "quality": "good", "boardCount": 9, "range": [19, 27, 0.98]},
        {"fingerprint": "a", "quality": "good", "boardCount": 9, "range": [19, 27, 0.97]},
        {"fingerprint": "b", "quality": "reflection", "boardCount": 9, "range": [400, 408, 0.96]},
        {"fingerprint": "b", "quality": "good", "boardCount": 9, "range": [400, 408, 0.99]}
      ],
      "expectedStatuses": ["auto_selected", "auto_selected"],
      "expectedRanges": [[19, 27], [400, 408]]
    },
    {
      "id": "later-completed-duplicate",
      "observations": [
        {"fingerprint": "a", "quality": "good", "boardCount": 9, "range": [1, 9, 0.98]},
        {"fingerprint": "a", "quality": "good", "boardCount": 9, "range": [1, 9, 0.97]},
        {"fingerprint": "b", "quality": "good", "boardCount": 9, "range": [10, 18, 0.98]},
        {"fingerprint": "b", "quality": "good", "boardCount": 9, "range": [10, 18, 0.97]},
        {"fingerprint": "a", "quality": "good", "boardCount": 9, "range": [1, 9, 0.99]},
        {"fingerprint": "a", "quality": "good", "boardCount": 9, "range": [1, 9, 0.99]}
      ],
      "expectedStatuses": ["auto_selected", "auto_selected", "skipped_existing_range"],
      "expectedRanges": [[1, 9], [10, 18], [1, 9]]
    },
    {
      "id": "later-good-candidate-completes-unresolved-range",
      "observations": [
        {"fingerprint": "a", "quality": "blur", "boardCount": 9, "range": [1, 9, 0.98]},
        {"fingerprint": "a", "quality": "cropped", "boardCount": 9, "range": [1, 9, 0.98]},
        {"fingerprint": "b", "quality": "good", "boardCount": 9, "range": [10, 18, 0.98]},
        {"fingerprint": "b", "quality": "good", "boardCount": 9, "range": [10, 18, 0.98]},
        {"fingerprint": "a", "quality": "good", "boardCount": 9, "range": [1, 9, 0.99]},
        {"fingerprint": "a", "quality": "good", "boardCount": 9, "range": [1, 9, 0.99]}
      ],
      "expectedStatuses": ["auto_selected", "auto_selected", "skipped_existing_range"],
      "expectedRanges": [[1, 9], [10, 18], [1, 9]],
      "expectedDuplicateOf": [null, null, 0]
    },
    {
      "id": "unsafe-images-stay-manual",
      "observations": [
        {"fingerprint": "c", "quality": "occluded", "boardCount": 9, "range": [100, 108, 0.99]},
        {"fingerprint": "c", "quality": "geometry_incomplete", "boardCount": 9, "range": [100, 108, 0.99]},
        {"fingerprint": "c", "quality": "cropped", "boardCount": 9, "range": [100, 108, 0.99]}
      ],
      "expectedStatuses": ["manual_required"],
      "expectedRanges": [[100, 108]]
    },
    {
      "id": "partial-final-page",
      "observations": [
        {"fingerprint": "d", "quality": "good", "boardCount": 5, "range": [500, 504, 0.98]},
        {"fingerprint": "d", "quality": "good", "boardCount": 5, "range": [500, 504, 0.97]}
      ],
      "expectedStatuses": ["auto_selected"],
      "expectedRanges": [[500, 504]]
    },
    {
      "id": "uncertain-range-stays-manual",
      "observations": [
        {"fingerprint": "e", "quality": "good", "boardCount": 9, "range": [700, 708, 0.62]},
        {"fingerprint": "e", "quality": "good", "boardCount": 9, "range": [700, 708, 0.64]}
      ],
      "expectedStatuses": ["manual_required"],
      "expectedRanges": [null]
    }
  ]
}

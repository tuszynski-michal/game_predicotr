{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "m5-board-cell-crops-v7-reviewed-symbol-aware.schema.json",
  "title": "M5 reviewed symbol-aware board cell crop report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boardCount",
    "calibrationProfileSetSha256",
    "calibrationProfileSetVersion",
    "cellCount",
    "croppedImageCount",
    "cropperVersion",
    "corpusManifestSha256",
    "detectionReportSha256",
    "imageCount",
    "images",
    "needsReviewCount",
    "normalizationReportSha256",
    "numpyVersion",
    "opencvVersion",
    "schemaVersion",
    "status"
  ],
  "properties": {
    "boardCount": { "const": 387 },
    "calibrationProfileSetSha256": { "$ref": "#/definitions/sha256" },
    "calibrationProfileSetVersion": {
      "const": "reviewed-symbol-grid-overrides-v1"
    },
    "cellCount": { "const": 5805 },
    "croppedImageCount": { "const": 43 },
    "cropperVersion": {
      "const": "board-cell-crops-v7-reviewed-symbol-aware-affine-v1"
    },
    "corpusManifestSha256": { "$ref": "#/definitions/sha256" },
    "detectionReportSha256": { "$ref": "#/definitions/sha256" },
    "imageCount": { "const": 43 },
    "images": {
      "type": "array",
      "minItems": 43,
      "maxItems": 43,
      "items": { "$ref": "#/definitions/image" }
    },
    "needsReviewCount": { "const": 0 },
    "normalizationReportSha256": { "$ref": "#/definitions/sha256" },
    "numpyVersion": { "type": "string", "minLength": 1 },
    "opencvVersion": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "status": { "const": "cropped" }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksumSha256",
        "columnIndex",
        "height",
        "relativePath",
        "rowIndex",
        "width"
      ],
      "properties": {
        "checksumSha256": { "$ref": "#/definitions/sha256" },
        "columnIndex": { "type": "integer", "minimum": 0, "maximum": 4 },
        "height": { "const": 90 },
        "relativePath": {
          "type": "string",
          "pattern": "^board-cell-crops-v7-reviewed-symbol-aware-affine-v1/"
        },
        "rowIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
        "width": { "const": 90 }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellHeight",
        "cellWidth",
        "columns",
        "insetPx",
        "logicalSlotHeight",
        "logicalSlotWidth",
        "rows"
      ],
      "properties": {
        "cellHeight": { "const": 90 },
        "cellWidth": { "const": 90 },
        "columns": { "const": 5 },
        "insetPx": { "const": 5 },
        "logicalSlotHeight": { "const": 100 },
        "logicalSlotWidth": { "const": 100 },
        "rows": { "const": 3 }
      }
    },
    "calibrationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorSequenceNumbers",
        "interpolationWeight",
        "profileId",
        "profileVersion"
      ],
      "properties": {
        "anchorSequenceNumbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "interpolationWeight": { "const": 0.0 },
        "profileId": { "$ref": "#/definitions/sha256" },
        "profileVersion": { "const": 1 }
      }
    },
    "symbolRefinement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineMedianResidualPx",
        "fallbackReason",
        "inlierCount",
        "refinedMedianResidualPx",
        "refinedP95ResidualPx",
        "refinerVersion",
        "reliableCenterCount",
        "status"
      ],
      "properties": {
        "baselineMedianResidualPx": { "type": ["number", "null"] },
        "fallbackReason": { "type": ["string", "null"] },
        "inlierCount": { "type": "integer", "minimum": 0, "maximum": 15 },
        "refinedMedianResidualPx": { "type": ["number", "null"] },
        "refinedP95ResidualPx": { "type": ["number", "null"] },
        "refinerVersion": { "const": "symbol-grid-refiner-affine-v1" },
        "reliableCenterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "status": { "enum": ["refined", "manual_override"] }
      }
    },
    "matrixRow": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boardChecksumSha256",
        "boardHeight",
        "boardRelativePath",
        "boardWidth",
        "cells",
        "grid",
        "overlayChecksumSha256",
        "overlayRelativePath",
        "positionIndex",
        "sourceQuad",
        "sourceQuadSource",
        "symbolRefinement",
        "transformMatrix"
      ],
      "properties": {
        "boardChecksumSha256": { "$ref": "#/definitions/sha256" },
        "boardHeight": { "const": 300 },
        "boardRelativePath": {
          "type": "string",
          "pattern": "^board-cell-crops-v7-reviewed-symbol-aware-affine-v1/"
        },
        "boardWidth": { "const": 500 },
        "calibrationProfile": { "$ref": "#/definitions/calibrationProfile" },
        "cells": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": { "$ref": "#/definitions/cell" }
        },
        "grid": { "$ref": "#/definitions/grid" },
        "overlayChecksumSha256": { "$ref": "#/definitions/sha256" },
        "overlayRelativePath": {
          "type": "string",
          "pattern": "^board-cell-crops-v7-reviewed-symbol-aware-affine-v1/"
        },
        "positionIndex": { "type": "integer", "minimum": 0, "maximum": 8 },
        "sourceQuad": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/point" }
        },
        "sourceQuadSource": {
          "enum": [
            "symbol-aware-projective-grid",
            "human-reviewed-symbol-grid-fallback"
          ]
        },
        "symbolRefinement": { "$ref": "#/definitions/symbolRefinement" },
        "transformMatrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/matrixRow" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceQuadSource": {
                "const": "human-reviewed-symbol-grid-fallback"
              }
            }
          },
          "then": {
            "required": ["calibrationProfile"],
            "properties": {
              "symbolRefinement": {
                "properties": {
                  "fallbackReason": { "type": "string", "minLength": 1 },
                  "status": { "const": "manual_override" }
                }
              }
            }
          },
          "else": {
            "not": { "required": ["calibrationProfile"] },
            "properties": {
              "symbolRefinement": {
                "properties": {
                  "baselineMedianResidualPx": { "type": "number" },
                  "fallbackReason": { "type": "null" },
                  "refinedMedianResidualPx": { "type": "number" },
                  "refinedP95ResidualPx": { "type": "number" },
                  "status": { "const": "refined" }
                }
              }
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boards",
        "normalizedRelativePath",
        "reviewReasons",
        "sourceChecksumSha256",
        "status"
      ],
      "properties": {
        "boards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": { "$ref": "#/definitions/board" }
        },
        "normalizedRelativePath": { "type": "string", "minLength": 1 },
        "reviewReasons": { "type": "array", "maxItems": 0 },
        "sourceChecksumSha256": { "$ref": "#/definitions/sha256" },
        "status": { "const": "cropped" }
      }
    }
  }
}

{
  "schemaVersion": 1,
  "status": "accepted",
  "corpusId": "m5-representative-corpus-v2",
  "metrics": {
    "pageDetectionRate": {"minimum": 0.95, "unit": "fraction_of_images"},
    "expectedBoardSetDetectionRate": {"minimum": 0.9, "unit": "fraction_of_images"},
    "boardPositionAssignmentAccuracy": {"minimum": 0.99, "unit": "fraction_of_boards"},
    "boardCornerErrorP95": {"maximum": 0.02, "unit": "image_diagonal_fraction"},
    "sequenceNumberExactAccuracy": {
      "minimum": 0.98,
      "unit": "fraction_of_boards",
      "appliesTo": "ocr_auto_accept"
    },
    "unresolvedContinuityConflictRate": {
      "maximum": 0.02,
      "unit": "fraction_of_boards",
      "appliesTo": "ocr_auto_accept"
    }
  },
  "rules": [
    "Every metric is reported separately; no aggregate score may hide a weak stage.",
    "A missing board is not excluded from geometry metrics.",
    "OCR continuity may flag a conflict but may not silently replace raw OCR.",
    "Accepted OCR thresholds enable auto-accept only; failure keeps OCR in manual-review-only mode."
  ]
}

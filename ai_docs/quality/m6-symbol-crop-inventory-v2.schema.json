{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-predictor.local/schemas/m6-symbol-crop-inventory-v2.schema.json",
  "title": "M6 calibrated symbol crop inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryVersion",
    "status",
    "corpusId",
    "corpusManifestSha256",
    "goldenAnnotationsSha256",
    "cropReportSha256",
    "cropperVersion",
    "calibrationProfileSetSha256",
    "calibrationProfileSetVersion",
    "qualityReportSha256",
    "trainingAllowed",
    "boardCount",
    "sampleCount",
    "sourceGroupCount",
    "sourceGroups",
    "cellWidth",
    "cellHeight",
    "samples"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "inventoryVersion": { "const": "symbol-crop-inventory-v2" },
    "status": { "const": "ready" },
    "corpusId": { "type": "string", "minLength": 1 },
    "corpusManifestSha256": { "$ref": "#/$defs/sha256" },
    "goldenAnnotationsSha256": { "$ref": "#/$defs/sha256" },
    "cropReportSha256": { "$ref": "#/$defs/sha256" },
    "cropperVersion": { "const": "board-cell-crops-v2-calibrated-v1" },
    "calibrationProfileSetSha256": { "$ref": "#/$defs/sha256" },
    "calibrationProfileSetVersion": { "const": "grid-calibration-profiles-v1" },
    "qualityReportSha256": { "$ref": "#/$defs/sha256" },
    "trainingAllowed": { "const": true },
    "boardCount": { "const": 387 },
    "sampleCount": { "const": 5805 },
    "sourceGroupCount": { "const": 2 },
    "sourceGroups": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cellWidth": { "const": 90 },
    "cellHeight": { "const": 90 },
    "samples": {
      "type": "array",
      "minItems": 5805,
      "maxItems": 5805,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleId",
        "cropSampleId",
        "observationId",
        "boardId",
        "sourceImageId",
        "sourceImageChecksumSha256",
        "sourceImageRelativePath",
        "sourceGroup",
        "sequenceNumber",
        "boardIndex",
        "cellIndex",
        "rowIndex",
        "columnIndex",
        "cropRelativePath",
        "cropChecksumSha256",
        "boardRelativePath",
        "boardChecksumSha256",
        "calibrationProfileId",
        "calibrationProfileVersion",
        "geometryStatus"
      ],
      "properties": {
        "sampleId": { "$ref": "#/$defs/sha256" },
        "cropSampleId": { "$ref": "#/$defs/sha256" },
        "observationId": { "$ref": "#/$defs/sha256" },
        "boardId": { "$ref": "#/$defs/sha256" },
        "sourceImageId": { "type": "string", "minLength": 1 },
        "sourceImageChecksumSha256": { "$ref": "#/$defs/sha256" },
        "sourceImageRelativePath": { "$ref": "#/$defs/relativePath" },
        "sourceGroup": { "type": "string", "minLength": 1 },
        "sequenceNumber": { "type": "integer", "minimum": 1, "maximum": 387 },
        "boardIndex": { "type": "integer", "minimum": 0, "maximum": 8 },
        "cellIndex": { "type": "integer", "minimum": 0, "maximum": 14 },
        "rowIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
        "columnIndex": { "type": "integer", "minimum": 0, "maximum": 4 },
        "cropRelativePath": { "$ref": "#/$defs/relativePath" },
        "cropChecksumSha256": { "$ref": "#/$defs/sha256" },
        "boardRelativePath": { "$ref": "#/$defs/relativePath" },
        "boardChecksumSha256": { "$ref": "#/$defs/sha256" },
        "calibrationProfileId": { "$ref": "#/$defs/sha256" },
        "calibrationProfileVersion": { "type": "integer", "minimum": 1 },
        "geometryStatus": { "const": "accepted" }
      }
    }
  }
}

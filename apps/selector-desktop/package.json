{
  "name": "@game-predictor/selector-desktop",
  "productName": "Selektor zdjec",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local offline JPEG selection for Windows",
  "author": "Game Predictor",
  "main": "dist/main.cjs",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:native": "node --experimental-strip-types --test test/native-checks.test.mjs",
    "test:foundation": "node --experimental-strip-types --test test/foundation.test.mjs",
    "test:project": "node --experimental-strip-types --test test/project.test.mjs",
    "test:ui": "node --experimental-strip-types --test test/renderer-contracts.test.mjs",
    "test:legacy": "node --experimental-strip-types --test test/legacy-contract.test.mjs",
    "test:legacy-recovery": "node --experimental-strip-types --test --test-name-pattern \"^(adoption recovers|versioned|unprepared adoption|prepared adoption|recovery rechecks)\" test/legacy-recovery.test.mjs",
    "test:legacy-process": "node --experimental-strip-types --test --test-name-pattern \"^new process recovers\" test/legacy-recovery.test.mjs",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "smoke:ux": "node scripts/smoke-ux.mjs",
    "smoke:shortcuts": "node scripts/smoke-shortcuts.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "smoke:legacy": "node scripts/smoke-legacy.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "smoke:release:shortcuts": "node scripts/smoke-release.mjs --shortcuts",
    "smoke:release:legacy": "node scripts/smoke-release.mjs --legacy",
    "smoke:release:ux": "node scripts/smoke-release.mjs --ux",
    "smoke:update": "node scripts/smoke-update.mjs",
    "release": "node scripts/release.mjs",
    "test:release": "node --test test/release.test.mjs",
    "package": "npm run build && electron-forge package --platform win32 --arch x64",
    "make": "npm run build && electron-forge make --platform win32 --arch x64"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@game-predictor/manual-image-selection-core": "0.1.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "electron": "42.11.12",
    "esbuild": "0.25.12",
    "eslint": "9.39.4",
    "typescript-eslint": "8.71.1",
    "playwright-core": "1.64.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}

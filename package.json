{
  "name": "game-predictor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13 <25",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "android": "npm run android --workspace @game-predictor/mobile",
    "android:build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_android_debug.ps1",
    "android:build:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_android_debug.ps1 -Variant Release",
    "android:device:accept": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_android_device_acceptance.ps1",
    "android:signing:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure_android_release_signing.ps1",
    "android:toolchain:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_android_toolchain.ps1 -AcceptAndroidSdkLicenses",
    "android:verify:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_android_apk.ps1",
    "admin:build": "npm run build --workspace @game-predictor/admin",
    "admin:dev": "npm run dev --workspace @game-predictor/admin",
    "admin:start": "npm run start --workspace @game-predictor/admin",
    "reviewer:build": "npm run build --workspace @game-predictor/reviewer",
    "reviewer:dev": "npm run dev --workspace @game-predictor/reviewer",
    "reviewer:start": "npm run start --workspace @game-predictor/reviewer",
    "reviewer:remote:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_remote_reviewer_tunnel.ps1",
    "reviewer:remote:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_remote_reviewer_tunnel.ps1",
    "reviewer:remote:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/get_remote_reviewer_tunnel_status.ps1",
    "reviewer:remote:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop_remote_reviewer_tunnel.ps1",
    "api:dev": ".venv\\Scripts\\python.exe -m game_predictor_api",
    "api:test": ".venv\\Scripts\\python.exe -m pytest services/api/tests",
    "db:baseline:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_postgres_baseline.ps1",
    "db:current": ".venv\\Scripts\\python.exe -m alembic current",
    "db:down": "docker compose -f infra/docker/compose.yaml down",
    "db:logs": "docker compose -f infra/docker/compose.yaml logs --follow postgres",
    "db:migrate": ".venv\\Scripts\\python.exe -m alembic upgrade head",
    "db:reset:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset_local_admin_database.ps1",
    "db:rollback": ".venv\\Scripts\\python.exe -m alembic downgrade base",
    "db:up": "docker compose -f infra/docker/compose.yaml up -d --wait postgres",
    "format": "prettier --write \"*.{css,js,json,md,mjs,ts,tsx,yaml,yml}\" \"apps/**/*.{css,js,json,md,mjs,ts,tsx,yaml,yml}\" \"infra/**/*.{css,js,json,md,mjs,ts,tsx,yaml,yml}\" \"packages/**/*.{css,js,json,md,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check \"*.{css,js,json,md,mjs,ts,tsx,yaml,yml}\" \"apps/**/*.{css,js,json,md,mjs,ts,tsx,yaml,yml}\" \"infra/**/*.{css,js,json,md,mjs,ts,tsx,yaml,yml}\" \"packages/**/*.{css,js,json,md,mjs,ts,tsx,yaml,yml}\"",
    "fixture:validate": ".venv\\Scripts\\python.exe scripts/validate_m1_fixture.py",
    "m35:dataset:generate": ".venv\\Scripts\\python.exe scripts/generate_m35_benchmark_dataset.py",
    "m35:dataset:validate": ".venv\\Scripts\\python.exe scripts/validate_m35_benchmark_dataset.py",
    "m35:apk:build": ".venv\\Scripts\\python.exe scripts/build_m35_benchmark_apk.py",
    "m35:device:benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_m35_device_benchmark.ps1",
    "m35:acceptance:evaluate": ".venv\\Scripts\\python.exe scripts/evaluate_m35_acceptance.py",
    "m35:repository:benchmark": ".venv\\Scripts\\python.exe scripts/benchmark_m35_repository.py",
    "m35:worker:benchmark": ".venv\\Scripts\\python.exe scripts/benchmark_m35_worker.py",
    "m4:import:fixture": ".venv\\Scripts\\python.exe scripts/generate_m4_import_fixture.py",
    "m4:import:acceptance": ".venv\\Scripts\\python.exe scripts/run_m4_import_acceptance.py",
    "m5:corpus:validate": ".venv\\Scripts\\python.exe scripts/validate_m5_corpus.py",
    "m5:images:discover": ".venv\\Scripts\\python.exe scripts/discover_m5_images.py",
    "m5:images:normalize": ".venv\\Scripts\\python.exe scripts/normalize_m5_images.py",
    "m5:boards:detect": ".venv\\Scripts\\python.exe scripts/detect_m5_boards.py",
    "m5:boards:crop": ".venv\\Scripts\\python.exe scripts/crop_m5_board_cells.py",
    "m5:boards:crop:v2": ".venv\\Scripts\\python.exe scripts/crop_m5_board_cells_v2.py",
    "m5:boards:crop:v2:quality": ".venv\\Scripts\\python.exe scripts/evaluate_m5_board_cell_crops_v2.py",
    "m5:grid:profiles": ".venv\\Scripts\\python.exe scripts/build_m5_grid_calibration_profiles.py",
    "m5:boards:crop:calibrated": ".venv\\Scripts\\python.exe scripts/crop_m5_board_cells_calibrated.py",
    "m5:boards:crop:calibrated:quality": ".venv\\Scripts\\python.exe scripts/evaluate_m5_calibrated_cell_crops.py",
    "m5:grid:prepare": ".venv\\Scripts\\python.exe scripts/review_m5_cell_grid.py prepare",
    "m5:grid:report": ".venv\\Scripts\\python.exe scripts/review_m5_cell_grid.py report",
    "m5:grid:review": ".venv\\Scripts\\python.exe scripts/review_m5_cell_grid.py serve",
    "m5:sequence:ocr": ".venv\\Scripts\\python.exe scripts/run_m5_sequence_ocr.py",
    "m5:benchmark": ".venv\\Scripts\\python.exe scripts/run_m5_image_benchmark.py",
    "m6:symbols:export": ".venv\\Scripts\\python.exe scripts/export_m6_symbol_dataset.py",
    "m6:symbols:inventory": ".venv\\Scripts\\python.exe scripts/export_m6_symbol_dataset.py inventory",
    "m6:symbols:onnx": ".venv\\Scripts\\python.exe scripts/export_m6_symbol_classifier_onnx.py",
    "m6:symbols:onnx:check": ".venv\\Scripts\\python.exe scripts/export_m6_symbol_classifier_onnx.py --check",
    "m6:symbols:confidence": ".venv\\Scripts\\python.exe scripts/calibrate_m6_symbol_confidence.py",
    "m6:symbols:confidence:check": ".venv\\Scripts\\python.exe scripts/calibrate_m6_symbol_confidence.py --check",
    "m6:symbols:review": ".venv\\Scripts\\python.exe scripts/review_m6_symbol_labels.py",
    "m6:symbols:split": ".venv\\Scripts\\python.exe scripts/split_m6_symbol_dataset.py",
    "m6:symbols:suggestions:check": ".venv\\Scripts\\python.exe scripts/evaluate_m6_symbol_suggestions.py --check",
    "m6:symbols:train": ".venv\\Scripts\\python.exe scripts/train_m6_symbol_classifier.py",
    "m65:workbench:acceptance": ".venv\\Scripts\\python.exe scripts/run_m65_workbench_acceptance.py --max-seconds 120",
    "m65:workbench:check": ".venv\\Scripts\\python.exe scripts/run_m65_workbench_acceptance.py --check",
    "m65:workbench:prepare": ".venv\\Scripts\\python.exe scripts/prepare_m65_real_workbench.py",
    "m7:load:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_m7_load_benchmark.ps1 -Profile smoke -TimeoutSeconds 120",
    "m7:load:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_m7_load_benchmark.ps1 -Profile full -TimeoutSeconds 900",
    "m7:load:check": ".venv\\Scripts\\python.exe scripts/run_m7_load_benchmark.py --profile full --check",
    "m7:operations": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_m7_operations_benchmark.ps1 -TimeoutSeconds 300",
    "m7:operations:check": ".venv\\Scripts\\python.exe scripts/run_m7_operations_benchmark.py --check",
    "m7:queue:decision": ".venv\\Scripts\\python.exe scripts/build_m7_queue_decision.py",
    "m7:queue:check": ".venv\\Scripts\\python.exe scripts/build_m7_queue_decision.py --check",
    "v01:release:prepare": ".venv\\Scripts\\python.exe scripts/build_v01_representative_release.py --prepare-only",
    "v01:release:validate": ".venv\\Scripts\\python.exe scripts/validate_v01_representative_release.py",
    "v01:release:build": ".venv\\Scripts\\python.exe scripts/build_v01_representative_release.py --build-apk",
    "lint": "npm run lint --workspaces --if-present && npm run python:lint && npm run powershell:check",
    "m2:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_m2_acceptance.ps1",
    "openapi:check": ".venv\\Scripts\\python.exe scripts/export_admin_openapi.py --check && npm run check:generated --workspace @game-predictor/admin-api-client",
    "openapi:generate": ".venv\\Scripts\\python.exe scripts/export_admin_openapi.py && npm run generate --workspace @game-predictor/admin-api-client",
    "test": "npm run test --workspaces --if-present && npm run python:test",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run python:typecheck",
    "worker:once": ".venv\\Scripts\\python.exe -m game_predictor_worker",
    "worker:poll": ".venv\\Scripts\\python.exe -m game_predictor_worker --poll",
    "windows:environment:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure_windows_user_environment.ps1",
    "windows:environment:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure_windows_user_environment.ps1 -CheckOnly",
    "python:lint": ".venv\\Scripts\\python.exe -m ruff check services/api services/worker scripts",
    "python:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_python_tests.ps1",
    "python:typecheck": ".venv\\Scripts\\python.exe -m mypy services/api/src services/worker/src scripts",
    "powershell:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check_powershell_syntax.ps1",
    "repository:benchmark": ".venv\\Scripts\\python.exe scripts/benchmark_m1_repository.py",
    "snapshot:generate": ".venv\\Scripts\\python.exe scripts/generate_m1_snapshot.py",
    "snapshot:validate": ".venv\\Scripts\\python.exe scripts/validate_m1_snapshot.py",
    "quality": "npm run format:check && npm run openapi:check && npm run lint && npm run typecheck && npm test && npm run snapshot:validate && npm run fixture:validate"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}

{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GameCreate": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/GameStatus",
            "default": "draft"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "title": "GameCreate",
        "type": "object"
      },
      "GameResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/GameStatus"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "title": "GameResponse",
        "type": "object"
      },
      "GameStatus": {
        "enum": [
          "draft",
          "active",
          "archived"
        ],
        "title": "GameStatus",
        "type": "string"
      },
      "GameUpdate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "GameUpdate",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SymbolCreate": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "displayOrder": {
            "minimum": 0.0,
            "title": "Displayorder",
            "type": "integer"
          },
          "imagePath": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imagepath"
          },
          "isWildcard": {
            "default": false,
            "title": "Iswildcard",
            "type": "boolean"
          },
          "mobileCode": {
            "maximum": 32767.0,
            "minimum": 1.0,
            "title": "Mobilecode",
            "type": "integer"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SymbolStatus",
            "default": "active"
          }
        },
        "required": [
          "mobileCode",
          "code",
          "name",
          "displayOrder"
        ],
        "title": "SymbolCreate",
        "type": "object"
      },
      "SymbolResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "displayOrder": {
            "title": "Displayorder",
            "type": "integer"
          },
          "gameId": {
            "format": "uuid",
            "title": "Gameid",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "imagePath": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imagepath"
          },
          "isWildcard": {
            "title": "Iswildcard",
            "type": "boolean"
          },
          "mobileCode": {
            "title": "Mobilecode",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SymbolStatus"
          }
        },
        "required": [
          "id",
          "gameId",
          "mobileCode",
          "code",
          "name",
          "imagePath",
          "isWildcard",
          "displayOrder",
          "status"
        ],
        "title": "SymbolResponse",
        "type": "object"
      },
      "SymbolStatus": {
        "enum": [
          "active",
          "archived"
        ],
        "title": "SymbolStatus",
        "type": "string"
      },
      "SymbolUpdate": {
        "additionalProperties": false,
        "properties": {
          "displayOrder": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayorder"
          },
          "imagePath": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imagepath"
          },
          "isWildcard": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Iswildcard"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SymbolStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "SymbolUpdate",
        "type": "object"
      }
    }

{
  "name": "@game-predictor/admin-api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node scripts/generate-client.mjs",
    "check:generated": "node scripts/check-generated-client.mjs",
    "lint": "node --check scripts/check-generated-client.mjs && node --check scripts/generate-client.mjs && node --check scripts/generated-client-drift.mjs && node --check scripts/generation.mjs",
    "test": "npm run build && tsx --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "tsx": "4.23.1",
    "typescript": "~6.0.3"
  }
}

  "cases": [
    {
      "id": "single-layout-has-only-spin-zero",
      "description": "A one-layout dataset evaluates no paid spins.",
      "manualCalculation": [
        "layout_count - 1 = 0",
        "spin 0 has no payout and no cost",
        "final payout = cost = net = 0"
      ],
      "input": {
        "startSequenceNumber": 1,
        "layoutCount": 1,
        "sequencePayouts": []
      },
      "expected": {
        "evaluatedSpinCount": 0,
        "finalCumulativePayout": 0,
        "finalCumulativeCost": 0,
        "finalNetCredits": 0,
        "positiveLocalPeaks": []
      }
    },
    {
      "id": "full-cycle-wraps-and-filters-negative-peak",
      "description": "Start 4 in a five-layout dataset visits 5,1,2,3 and never revisits 4.",
      "manualCalculation": [
        "sequences = [5,1,2,3]",
        "payouts = [0,5,20,0], cumulative payouts = [0,5,25,25]",
        "costs = [10,20,30,40], net = [-10,-15,-5,-15]",
        "local peak -5 is not positive, so the table is empty"
      ],
      "input": {
        "startSequenceNumber": 4,
        "layoutCount": 5,
        "sequencePayouts": [
          {
            "sequenceNumber": 5,
            "payoutCredits": 0
          },
          {
            "sequenceNumber": 1,
            "payoutCredits": 5
          },
          {
            "sequenceNumber": 2,
            "payoutCredits": 20
          },
          {
            "sequenceNumber": 3,
            "payoutCredits": 0
          }
        ]
      },
      "expected": {
        "evaluatedSpinCount": 4,
        "finalCumulativePayout": 25,
        "finalCumulativeCost": 40,
        "finalNetCredits": -15,
        "positiveLocalPeaks": []
      }
    },
    {
      "id": "one-positive-local-peak",
      "description": "A rising pair followed by a decline produces one peak.",
      "manualCalculation": [
        "net = [10,20,10,0,-10]",
        "spin 2 is the only local peak: payout 20, cumulative 40, cost 20, net 20"
      ],
      "input": {
        "startSequenceNumber": 2,
        "layoutCount": 6,
        "sequencePayouts": [
          {
            "sequenceNumber": 3,
            "payoutCredits": 20

          {
            "sequenceNumber": 1,
            "payoutCredits": 0
          }
        ]
      },
      "expected": {
        "evaluatedSpinCount": 5,
        "finalCumulativePayout": 40,
        "finalCumulativeCost": 50,
        "finalNetCredits": -10,
        "positiveLocalPeaks": [
          {
            "spinNumber": 2,
            "sequenceNumber": 4,
            "spinPayout": 20,
            "cumulativePayout": 40,
            "cumulativeCost": 20,
            "netCredits": 20
          }
        ]
      }
    },
    {

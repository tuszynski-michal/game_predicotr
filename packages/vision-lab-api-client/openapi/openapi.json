{
  "components": {
    "schemas": {
      "Board": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/Cell"
            },
            "title": "Cells",
            "type": "array"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "title": "Nodes",
            "type": "array"
          },
          "position_index": {
            "title": "Position Index",
            "type": "integer"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "needs_review",
              "absent",
              "occluded",
              "unreadable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "position_index",
          "status",
          "nodes",
          "reasons",
          "cells"
        ],
        "title": "Board",
        "type": "object"
      },
      "Cell": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Id"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "status": {
            "enum": [
              "available",
              "outside_source",
              "geometry_invalid"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "index",
          "asset_id",
          "status"
        ],
        "title": "Cell",
        "type": "object"
      },
      "DetectRequest": {
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "topology": {
            "$ref": "#/components/schemas/Topology-Input"
          }
        },
        "required": [
          "source_id"
        ],
        "title": "DetectRequest",
        "type": "object"
      },
      "GeometryResult": {
        "additionalProperties": false,
        "properties": {
          "boards": {
            "items": {
              "$ref": "#/components/schemas/Board"
            },
            "title": "Boards",
            "type": "array"
          },
          "height": {
            "default": 0,
            "title": "Height",
            "type": "integer"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "detected",
              "failed",
              "unsupported",
              "invalid_image"
            ],
            "title": "Status",
            "type": "string"
          },
          "topology": {
            "$ref": "#/components/schemas/Topology-Output"
          },
          "width": {
            "default": 0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "source_id",
          "topology",
          "model_version",
          "status",
          "boards",
          "reasons",
          "width",
          "height"
        ],
        "title": "GeometryResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Point": {
        "additionalProperties": false,
        "properties": {
          "provenance": {
            "default": "baseline_proposal",
            "enum": [
              "baseline_proposal",
              "human",
              "model"
            ],
            "title": "Provenance",
            "type": "string"
          },
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "provenance"
        ],
        "title": "Point",
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "title": "Asset Id",
            "type": "string"
          },
          "duplicate_count": {
            "default": 1,
            "title": "Duplicate Count",
            "type": "integer"
          },
          "family_candidate": {
            "title": "Family Candidate",
            "type": "string"
          },
          "family_verified": {
            "default": false,
            "title": "Family Verified",
            "type": "boolean"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "game_id": {
            "title": "Game Id",
            "type": "string"
          },
          "game_name": {
            "title": "Game Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "data",
              "comparison_only",
              "777_v2_declared"
            ],
            "title": "Role",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "folder",
              "database"
            ],
            "title": "Source Kind",
            "type": "string"
          },
          "training_eligible": {
            "const": false,
            "default": false,
            "title": "Training Eligible",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "game_id",
          "game_name",
          "filename",
          "sha256",
          "asset_id",
          "source_kind",
          "family_candidate",
          "family_verified",
          "role",
          "training_eligible",
          "duplicate_count"
        ],
        "title": "Source",
        "type": "object"
      },
      "SourcePage": {
        "additionalProperties": false,
        "properties": {
          "games": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Games",
            "type": "object"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "sources",
          "total",
          "games"
        ],
        "title": "SourcePage",
        "type": "object"
      },
      "Topology-Input": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "default": 5,
            "enum": [
              3,
              5
            ],
            "title": "Columns",
            "type": "integer"
          },
          "rows": {
            "const": 3,
            "default": 3,
            "title": "Rows",
            "type": "integer"
          }
        },
        "title": "Topology",
        "type": "object"
      },
      "Topology-Output": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "default": 5,
            "enum": [
              3,
              5
            ],
            "title": "Columns",
            "type": "integer"
          },
          "rows": {
            "const": 3,
            "default": 3,
            "title": "Rows",
            "type": "integer"
          }
        },
        "required": [
          "columns",
          "rows"
        ],
        "title": "Topology",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Vision Lab API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/assets/{asset_id}": {
      "get": {
        "operationId": "get_asset",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "title": "Asset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "image/jpeg": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Asset"
      }
    },
    "/geometry": {
      "post": {
        "operationId": "detect_geometry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeometryResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Geometry"
      }
    },
    "/sources": {
      "get": {
        "operationId": "list_sources",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 24,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "game",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Game"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sources"
      }
    }
  }
}

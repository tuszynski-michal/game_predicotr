  "hypothesis": "Node precision of the board stage is the bottleneck of the 0.02 NME tolerance: training it on every board of each photo with a lower, gentler learning rate improves NME and therefore the complete-and-correct share, at the cost of fewer photos per step.",
  "metrics": {
    "board_correct_max_nme": 0.02,
    "board_correct_max_node_error": 0.05,
    "false_board": "prediction whose quad IoU with every label is below 0.5",
    "image_macro": "T05: per label min(1, NME), missing or invalid = 1, mean per photo, mean over photos",
    "match_min_iou": 0.5,
    "matching": "hungarian-max-quad-iou; pairs below min IoU are not matched",
    "normalization": "euclidean distance of label nodes 0 and 23 (TL-BR diagonal, as T05)",
    "photo_complete_correct": "every label board matched and correct and no false board",
    "quad": "corner nodes 0, 5, 23, 18 (TL, TR, BR, BL)",
    "selection": "max photo_complete_correct_rate on development; tie -> lower image_macro; tie -> earlier round",
    "version": "neural-grid-metrics-v1"
  },
  "model_version": "neural-grid-v1",
  "name": "C",
  "optimization": {
